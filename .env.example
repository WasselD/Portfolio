# Copy to .env.local for local dev, and add the same three in your host's
# environment settings (Netlify: Site configuration -> Environment variables).
# These are baked in at BUILD time, so redeploy after changing them.

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same email you put in supabase/setup.sql. (Convenience check only;
# the database enforces the real rule.)
NEXT_PUBLIC_ADMIN_EMAIL=wasselforbusiness@gmail.com
